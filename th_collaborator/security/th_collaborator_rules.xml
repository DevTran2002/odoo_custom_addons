<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ========================================== -->
        <!-- QUY TẮC BẢN GHI: HỒ SƠ CỘNG TÁC VIÊN      -->
        <!-- ========================================== -->
        <!-- Nhân viên: Chỉ xem và thao tác trên CTV do mình phụ trách -->
        <record id="th_collaborator_profile_officer_rule" model="ir.rule">
            <field name="name">Cộng tác viên: Nhân viên chỉ xem hồ sơ phụ trách</field>
            <field name="model_id" ref="model_th_collaborator_profile"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_officer'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Pháp chế, Quản lý, Admin: Xem và thao tác toàn bộ hồ sơ CTV -->
        <record id="th_collaborator_profile_manager_rule" model="ir.rule">
            <field name="name">Cộng tác viên: Cấp trên xem toàn bộ hồ sơ</field>
            <field name="model_id" ref="model_th_collaborator_profile"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_legal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ========================================== -->
        <!-- QUY TẮC BẢN GHI: HỢP ĐỒNG CỘNG TÁC VIÊN    -->
        <!-- ========================================== -->
        <!-- Nhân viên: Chỉ xem và thao tác trên hợp đồng do mình phụ trách -->
        <record id="th_collaborator_contract_officer_rule" model="ir.rule">
            <field name="name">Hợp đồng: Nhân viên chỉ xem hợp đồng phụ trách</field>
            <field name="model_id" ref="model_th_collaborator_contract"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_officer'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', '=', False)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Pháp chế, Quản lý, Admin: Xem và thao tác toàn bộ hợp đồng -->
        <record id="th_collaborator_contract_manager_rule" model="ir.rule">
            <field name="name">Hợp đồng: Cấp trên xem toàn bộ hợp đồng</field>
            <field name="model_id" ref="model_th_collaborator_contract"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_legal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ========================================== -->
        <!-- QUY TẮC BẢN GHI: TỆP ĐÍNH KÈM HỢP ĐỒNG     -->
        <!-- ========================================== -->
        <!-- Nhân viên: Chỉ xem tệp thuộc hợp đồng mình phụ trách -->
        <record id="th_collaborator_contract_document_officer_rule" model="ir.rule">
            <field name="name">Tệp hợp đồng: Nhân viên chỉ xem tệp của mình</field>
            <field name="model_id" ref="model_th_collaborator_contract_document"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_officer'))]"/>
            <field name="domain_force">['|', ('th_contract_id.user_id', '=', user.id), ('th_contract_id.user_id', '=', False)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Pháp chế, Quản lý, Admin: Xem toàn bộ tệp hợp đồng -->
        <record id="th_collaborator_contract_document_manager_rule" model="ir.rule">
            <field name="name">Tệp hợp đồng: Cấp trên xem toàn bộ tệp</field>
            <field name="model_id" ref="model_th_collaborator_contract_document"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_legal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ========================================== -->
        <!-- QUY TẮC BẢN GHI: LỊCH SỬ MAIL ĐÃ GỬI       -->
        <!-- ========================================== -->
        <!-- Nhân viên: Chỉ xem mail thuộc hợp đồng mình phụ trách -->
        <record id="th_collaborator_mail_sent_officer_rule" model="ir.rule">
            <field name="name">Mail đã gửi: Nhân viên chỉ xem mail mình gửi</field>
            <field name="model_id" ref="model_th_collaborator_mail_sent"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_officer'))]"/>
            <field name="domain_force">['|', ('th_contract_id.user_id', '=', user.id), ('th_contract_id.user_id', '=', False)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Pháp chế, Quản lý, Admin: Xem toàn bộ lịch sử mail -->
        <record id="th_collaborator_mail_sent_manager_rule" model="ir.rule">
            <field name="name">Mail đã gửi: Cấp trên xem toàn bộ mail</field>
            <field name="model_id" ref="model_th_collaborator_mail_sent"/>
            <field name="groups" eval="[(4, ref('th_role_collaborator_legal'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>

