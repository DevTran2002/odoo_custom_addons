<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View Hồ sơ CTV -->
    <record id="th_collaborator_profile_tree_view" model="ir.ui.view">
        <field name="name">th.collaborator.profile.tree</field>
        <field name="model">th.collaborator.profile</field>
        <field name="arch" type="xml">
            <tree string="Cộng tác viên">
                <field name="th_sequence" string="STT" optional="show"/>
                <field name="name"/>
                <field name="th_program" optional="show"/>
                <field name="th_phone"/>
                <field name="th_email"/>
                <field name="th_email_cc" optional="hide"/>
                <field name="th_identification_id" optional="show"/>
                <field name="th_permanent_address" optional="hide"/>
                <field name="th_tax_code" optional="show"/>
                <field name="th_bank_account_number" optional="show"/>
                <field name="th_bank_name" optional="hide"/>
                <field name="th_bank_branch" optional="hide"/>
                <field name="th_birthday" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="th_contract_count" string="Tổng số HĐ"/>
            </tree>
        </field>
    </record>

    <!-- Form View Hồ sơ CTV -->
    <record id="th_collaborator_profile_form_view" model="ir.ui.view">
        <field name="name">th.collaborator.profile.form</field>
        <field name="model">th.collaborator.profile</field>
        <field name="arch" type="xml">
            <form string="Cộng tác viên">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_collaborator_contracts" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="th_contract_count" widget="statinfo" string="Hợp đồng"/>
                        </button>
                        <button name="th_action_view_sent_mails"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paper-plane">
                            <field name="th_mail_sent_count" widget="statinfo" string="Đã gửi"/>
                        </button>
                        <button name="th_action_view_delivered_mails"
                                type="object"
                                class="oe_stat_button">
                            <field name="th_mail_delivered_ratio" widget="percentpie" string="Đã nhận"/>
                        </button>
                        <button name="th_action_view_failed_mails"
                                type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('th_mail_failed_count', '=', 0)]}">
                            <field name="th_mail_failed_ratio" widget="percentpie" string="Lỗi"/>
                        </button>
                    </div>
                    <field name="th_mail_failed_count" invisible="1"/>
                    <field name="th_portrait_image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Họ và tên CTV" required="1"/></h1>
                        <label for="th_program" class="oe_edit_only"/>
                        <h3><field name="th_program" placeholder="Chương trình" required="1"/></h3>
                    </div>
                    <group>
                        <group string="Thông tin liên hệ">
                            <field name="th_sequence"/>
                            <field name="th_phone" widget="phone" required="1"/>
                            <field name="th_email" widget="email" required="1"/>
                            <field name="th_email_cc" widget="email" help="Email của người phụ trách để khi gửi hợp đồng sẽ được cc"/>
                            <field name="user_id" string="Người phụ trách hợp đồng" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="th_birthday" required="1"/>
                        </group>
                        <group string="Định danh &amp; Thuế">
                            <field name="th_identification_id" required="1"/>
                            <field name="th_id_issue_date" required="1"/>
                            <field name="th_id_issue_place" required="1"/>
                            <field name="th_permanent_address"/>
                            <field name="th_tax_code" required="1"/>
                        </group>
                        <group string="Tài khoản ngân hàng">
                            <field name="th_bank_account_number" required="1"/>
                            <field name="th_bank_name" required="1"/>
                            <field name="th_bank_branch"/>
                        </group>
                    </group>
                    <notebook>
                    <page string="Hợp đồng đã hoàn tất" name="th_completed_contracts">
                            <field name="th_completed_contract_ids" readonly="1">
                                <tree string="Hợp đồng hoàn tất" create="0" delete="0">
                                    <field name="th_code" string="Mã hợp đồng"/>
                                    <field name="name" string="Tên hợp đồng"/>
                                    <field name="th_contract_type_ids" widget="many2many_tags" options="{'color_field': 'th_color'}"/>
                                    <field name="th_final_file_name" string="Hợp đồng đủ 2 chữ ký"/>
                                    <field name="th_expiration_status" widget="badge" optional="show"
                                            decoration-danger="th_expiration_status == 'expired'"
                                            decoration-success="th_expiration_status == 'valid'"/>
                                    <field name="date_start" string="Ngày bắt đầu" optional="show"/>
                                    <field name="date_end" string="Ngày kết thúc" optional="show"/>
                                    <button name="th_action_download_final_contracts" type="object" icon="fa-download"
                                            title="Tải tệp hoàn tất 2 chữ ký" class="text-success"
                                            attrs="{'invisible': [('th_final_file_name', '=', 'Chưa có')]}"/>
                                    <button name="action_open_contract_form" type="object" icon="fa-external-link"
                                            title="Xem chi tiết hợp đồng"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Hình ảnh định danh" name="th_identification_images">
                            <div class="row g-3 py-2">
                                <div class="col-md-6">
                                    <div class="card  rounded shadow-sm">
                                        <div class="card-header bg-light py-2 px-3 fw-bold text-dark">
                                            Mặt trước CCCD
                                        </div>
                                        <div class="card-body p-2 bg-white">
                                            <div class="th_id_image_box">
                                                <field name="th_id_front_image" widget="image" options="{'size': [520, 330], 'zoom': true}" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card  rounded shadow-sm">
                                        <div class="card-header bg-light py-2 px-3 fw-bold text-dark">
                                            Mặt sau CCCD
                                        </div>
                                        <div class="card-body p-2 bg-white">
                                            <div class="th_id_image_box">
                                                <field name="th_id_back_image" widget="image" options="{'size': [520, 330], 'zoom': true}" nolabel="1"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                        
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View Hồ sơ CTV -->
    <record id="th_collaborator_profile_search_view" model="ir.ui.view">
        <field name="name">th.collaborator.profile.search</field>
        <field name="model">th.collaborator.profile</field>
        <field name="arch" type="xml">
            <search string="Cộng tác viên">
                <field name="name"/>
                <field name="th_program"/>
                <field name="th_phone"/>
                <field name="th_email"/>
                <field name="th_email_cc" optional="hide"/>
                <field name="th_identification_id"/>
                <field name="th_permanent_address"/>
                <field name="th_tax_code"/>
                <field name="th_bank_account_number"/>
                <field name="th_bank_name"/>
                <field name="th_bank_branch"/>
                <field name="user_id"/>
                <filter name="th_filter_my" string="CTV của tôi" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="th_group_user" string="Người phụ trách" context="{'group_by': 'user_id'}"/>
                    <filter name="th_group_program" string="Chương trình" context="{'group_by': 'th_program'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Hồ sơ CTV -->
    <record id="th_collaborator_profile_action" model="ir.actions.act_window">
        <field name="name">Cộng tác viên</field>
        <field name="res_model">th.collaborator.profile</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="th_collaborator_profile_search_view"/>
        <field name="context">{'search_default_th_filter_my': 1}</field>
    </record>
</odoo>
