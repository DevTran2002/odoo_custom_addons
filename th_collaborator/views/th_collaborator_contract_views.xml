<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View Hợp đồng CTV -->
    <record id="th_collaborator_contract_tree_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.tree</field>
        <field name="model">th.collaborator.contract</field>
        <field name="arch" type="xml">
            <tree string="Hợp đồng CTV">
                <header>
                    <button name="th_action_send_contract_mail_batch" type="object" string="Gửi mail hợp đồng"
                            confirm="Bạn có chắc chắn muốn gửi email cho các hợp đồng đã chọn không?"/>
                    <button name="th_action_download_company_contracts" type="object" string="Tải HĐ công ty"/>
                    <button name="th_action_download_self_contracts" type="object" string="Tải HĐ CTV nộp"/>
                    <button name="th_action_download_final_contracts" type="object" string="Tải HĐ hoàn tất"/>
                </header>
                <field name="th_code"/>
                <field name="name"/>
                <field name="th_collaborator_id"/>
                <field name="th_phone" optional="show"/>
                <field name="th_upload_url" widget="CopyClipboardChar" optional="hide"/>
                <field name="th_contract_type_ids" widget="many2many_tags" options="{'color_field': 'th_color'}" optional="show"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="show"/>
                <field name="th_expiration_status" widget="badge" optional="show"
                       decoration-danger="th_expiration_status == 'expired'"
                       decoration-success="th_expiration_status == 'valid'"/>
                <field name="th_company_file_name" string="HĐ công ty cung cấp"/>
                <field name="th_self_file_name" string="HĐ CTV nộp"/>
                <field name="th_final_file_name" string="HĐ đủ 2 chữ ký"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-primary="state in ('sent', 'valid')"
                       decoration-warning="state in ('submitted', 'pending_sign')"
                       decoration-success="state == 'close'"
                       decoration-danger="state in ('cancel', 'mail_error')"/>
                <button name="th_action_download_company_contracts" type="object" icon="fa-file-text-o"
                        title="Tải về tệp công ty cung cấp" attrs="{'invisible': [('th_company_file_name', '=', 'Chưa có file')]}"/>
                <button name="th_action_download_self_contracts" type="object" icon="fa-download"
                        title="Tải về tệp CTV nộp" class="text-primary" attrs="{'invisible': [('th_self_file_name', '=', 'Chưa nộp')]}"/>
                <button name="th_action_download_final_contracts" type="object" icon="fa-check-circle"
                        title="Tải về tệp hoàn tất 2 chữ ký" class="text-success" attrs="{'invisible': [('th_final_file_name', '=', 'Chưa có')]}"/>
            </tree></field>
    </record>
    <!-- Kanban View Hợp đồng CTV -->
    <record id="th_collaborator_contract_kanban_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.kanban</field>
        <field name="model">th.collaborator.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="th_code"/>
                <field name="th_collaborator_id"/>
                <field name="user_id"/>
                <field name="th_batch_date"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state"/>
                <field name="th_contract_type_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record">
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-primary">
                                        <field name="th_code"/>
                                    </strong>
                                    <div class="text-muted">
                                        <field name="name"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body mb-2">
                                <div>
                                    <strong>CTV:
                                    
                                    </strong>
                                    <field name="th_collaborator_id"/>
                                </div>
                                <div t-if="record.th_batch_date.raw_value" class="text-muted small">
                                    Ngày đẩy: <field name="th_batch_date"/>
                                </div>
                                <div class="mt-1">
                                    <field name="th_contract_type_ids" widget="many2many_tags" options="{'color_field': 'th_color'}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'default', 'open': 'info', 'sent': 'primary', 'submitted': 'warning', 'pending_sign': 'warning', 'valid': 'info', 'close': 'success', 'cancel': 'danger', 'mail_error': 'danger'}}"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban></field>
    </record>
    <!-- Form View Hợp đồng CTV -->
    <record id="th_collaborator_contract_form_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.form</field>
        <field name="model">th.collaborator.contract</field>
        <field name="arch" type="xml">
            <form string="Hợp đồng CTV">
                <header>
                    <button name="action_open_upload_document_wizard" type="object"
                            string="Upload hợp đồng" class="oe_highlight" icon="fa-upload"
                            attrs="{'invisible': ['|', ('state', 'not in', ('draft', 'open')), '|', ('th_is_readonly', '=', True), ('th_company_file_name', '!=', 'Chưa có file')]}"/>
                    <button name="action_open_upload_document_wizard" type="object"
                            string="Upload hợp đồng" class="btn-secondary" icon="fa-upload"
                            attrs="{'invisible': ['|', ('state', 'not in', ('draft', 'open')), '|', ('th_is_readonly', '=', True), ('th_company_file_name', '=', 'Chưa có file')]}"/>
                    <button name="action_open_upload_document_wizard" type="object"
                            string="Upload bổ sung" class="btn-secondary" icon="fa-upload"
                            attrs="{'invisible': ['|', ('state', '!=', 'submitted'), ('th_is_readonly', '=', True)]}"/>
                    <button name="action_open_upload_document_wizard" type="object"
                            string="Upload bản 2 chữ ký" class="oe_highlight" icon="fa-upload"
                            attrs="{'invisible': ['|', ('state', 'not in', ('submitted', 'pending_sign', 'valid')), '|', ('th_is_readonly', '=', True), ('th_final_file_name', '!=', 'Chưa có')]}"/>
                    <button name="action_open_upload_document_wizard" type="object"
                            string="Upload bản 2 chữ ký" class="btn-secondary" icon="fa-upload"
                            attrs="{'invisible': ['|', ('state', 'not in', ('submitted', 'pending_sign', 'valid')), '|', ('th_is_readonly', '=', True), ('th_final_file_name', '=', 'Chưa có')]}"/>

                    <button name="th_action_send_contract_mail" type="object" string="Gửi mail hợp đồng" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', 'not in', ('draft', 'open')), '|', ('th_is_readonly', '=', True), ('th_company_file_name', '=', 'Chưa có file')]}"/>

                    <button name="th_action_send_contract_mail" type="object" string="Gửi lại mail" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', '!=', 'mail_error'), ('th_is_readonly', '=', True)]}"/>
                    <button name="th_action_send_contract_mail" type="object" string="Gửi lại mail" class="btn-secondary"
                            attrs="{'invisible': ['|', ('state', '!=', 'sent'), ('th_is_readonly', '=', True)]}"
                            confirm="Hợp đồng này đã được gửi mail trước đó. Bạn có chắc muốn gửi lại?"/>

                    <button name="action_set_close" type="object" string="Xác nhận hoàn tất" class="btn-secondary"
                            attrs="{'invisible': ['|', ('state', 'not in', ('submitted', 'pending_sign', 'valid')), '|', ('th_is_readonly', '=', True), ('th_final_file_name', '=', 'Chưa có')]}"/>

                    <button name="th_action_send_final_contract_mail" type="object" string="Gửi trả HĐ đủ 2 chữ ký" class="oe_highlight"
                            attrs="{'invisible': ['|', ('state', 'not in', ('submitted', 'pending_sign', 'valid')), '|', ('th_is_readonly', '=', True), ('th_final_file_name', '=', 'Chưa có')]}"/>

                    <button name="action_set_draft" type="object" string="Khôi phục dự thảo" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'cancel')]}"/>
                    <button name="action_set_draft" type="object" string="Khôi phục dự thảo" class="btn-secondary"
                            attrs="{'invisible': [('state', '!=', 'mail_error')]}"/>

                    <field name="th_contract_flow" invisible="1"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,sent,pending_sign,valid,close"
                           options="{'clickable': '1'}"
                           force_save="1"
                           attrs="{'invisible': ['&amp;', ('state', '!=', 'pending_sign'), ('th_contract_flow', '!=', 'raw_template')], 'readonly': [('th_is_readonly', '=', True)]}"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open,sent,submitted,valid,close"
                           options="{'clickable': '1'}"
                           force_save="1"
                           attrs="{'invisible': ['|', ('state', '=', 'pending_sign'), ('th_contract_flow', '=', 'raw_template')], 'readonly': [('th_is_readonly', '=', True)]}"/>
                </header>
                <sheet>
                    <field name="th_is_readonly" invisible="1"/>
                    <style>
                        .ribbon {
                            margin-top: 21px !important;
                        }
                    </style>
                    <widget name="web_ribbon" title="Hết hạn" bg_color="bg-danger"
                            attrs="{'invisible': [('th_is_expired', '=', False)]}"/>
                    <field name="th_is_expired" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="th_action_view_sent_mails"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paper-plane">
                            <field name="th_mail_sent_count" widget="statinfo" string="Đã gửi"/>
                        </button>
                        <button name="th_action_view_delivered_mails"
                                type="object"
                                class="oe_stat_button">
                            <field name="th_mail_delivered_ratio" widget="percentpie" string="Đã nhận"/>
                        </button>
                        <button name="th_action_view_failed_mails"
                                type="object"
                                class="oe_stat_button"
                                attrs="{'invisible': [('th_mail_failed_count', '=', 0)]}">
                            <field name="th_mail_failed_ratio" widget="percentpie" string="Lỗi"/>
                        </button>
                    </div>
                    <field name="th_mail_failed_count" invisible="1"/>
                    <field name="th_company_file_name" invisible="1"/>
                    <field name="th_final_file_name" invisible="1"/>
                    <field name="th_mail_error" invisible="1"/>
                    <div class="oe_title">
                        <label for="th_code" class="oe_edit_only"/>
                        <h2>
                            <field name="th_code" placeholder="Mã hợp đồng" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                        </h2>
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Tên hợp đồng" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="th_collaborator_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                            <field name="th_phone" widget="phone"/>
                            <field name="th_email" widget="email"/>
                            <field name="user_id" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                            <field name="th_contract_type_ids" widget="many2many_tags"
                                   options="{'no_open': True, 'no_create': True, 'no_create_edit': True}" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                            <field name="th_batch_date" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                        </group>
                        <group>
                            <field name="date_start" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                            <field name="date_end" required="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}"/>
                            <field name="th_expiration_status"/>
                            <field name="th_is_signed" readonly="1"/>
                            <field name="th_mail_sent_date" readonly="1"/>
                            <field name="th_last_upload_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách tệp hợp đồng" name="th_documents">
                            <field name="th_document_ids" nolabel="1"
                                   attrs="{'readonly': [('th_is_readonly', '=', True)]}">
                                <tree create="false" no_open="1">
                                    <field name="name" string="Tên tệp"/>
                                    <field name="th_document_type"/>
                                    <field name="th_file" filename="th_file_name" widget="binary" string="Tệp đính kèm"/>
                                    <field name="th_file_name" invisible="1"/>
                                    <field name="th_uploaded_by"/>
                                    <field name="th_upload_date" readonly="1"/>
                                    <field name="th_user_id" widget="many2one_avatar_user" readonly="1" optional="show" options="{'no_open': True}"/>
                                    <field name="th_notes"/>
                                </tree></field>
                        </page>
                        <page string="Cổng tải lên hợp đồng" name="th_upload_portal">
                            <group>
                                <label for="th_upload_url"/>
                                <div class="o_row">
                                    <field name="th_upload_url" widget="CopyClipboardChar" readonly="1"/>
                                    <button name="th_action_regenerate_token" type="object"
                                            string="Tạo lại link" class="btn-link"
                                            attrs="{'invisible': [('th_is_readonly', '=', True)]}"
                                            confirm="Tạo lại link upload sẽ vô hiệu hóa đường link cũ đã gửi cho CTV. Bạn có chắc muốn tiếp tục?"/>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form></field>
    </record>
    <!-- Search View Hợp đồng CTV -->
    <record id="th_collaborator_contract_search_view" model="ir.ui.view">
        <field name="name">th.collaborator.contract.search</field>
        <field name="model">th.collaborator.contract</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm hợp đồng">
                <field name="th_code"/>
                <field name="name"/>
                <field name="th_collaborator_id"/>
                <field name="th_phone"/>
                <field name="user_id"/>
                <field name="th_batch_date"/>
                <filter name="filter_state_draft" string="Dự thảo" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_open" string="Đang thực hiện" domain="[('state', '=', 'open')]"/>
                <filter name="filter_state_sent" string="Gửi mail (Đã gửi)" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_state_submitted" string="Chờ duyệt" domain="[('state', '=', 'submitted')]"/>
                <filter name="filter_state_pending_sign" string="Chờ ký" domain="[('state', '=', 'pending_sign')]"/>
                <filter name="filter_state_valid" string="Đã duyệt hợp lệ" domain="[('state', '=', 'valid')]"/>
                <filter name="filter_state_close" string="Hoàn tất" domain="[('state', '=', 'close')]"/>
                <filter name="filter_state_mail_error" string="Gửi mail lỗi" domain="[('state', '=', 'mail_error')]"/>
                <filter name="filter_state_cancel" string="Đã hủy" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="filter_not_sent" string="Chưa gửi mail" domain="[('state', '=', 'open')]"/>
                <filter name="filter_mail_sent" string="Đã gửi mail" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_mail_error" string="Lỗi gửi mail" domain="['|', ('state', '=', 'mail_error'), ('th_mail_error', '!=', False)]"/>
                <separator/>
                <filter name="filter_waiting_valid" string="Chờ duyệt / Chờ ký" domain="[('state', 'in', ('submitted', 'pending_sign'))]"/>
                <filter name="filter_has_final" string="Đã có bản 2 chữ ký" domain="[('th_final_attachment_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_uploaded" string="CTV đã nộp file" domain="[('th_self_attachment_ids', '!=', False)]"/>
                <filter name="filter_not_uploaded" string="Chưa nộp file" domain="[('th_self_attachment_ids', '=', False), ('state', 'in', ('open', 'sent'))]"/>
                <separator/>
                <filter name="filter_contract_expired" string="Hợp đồng hết hạn" domain="[('th_is_expired', '=', True)]"/>
                <filter name="filter_contract_not_expired" string="Hợp đồng chưa hết hạn" domain="[('th_is_expired', '=', False)]"/>
                <filter name="filter_overdue_submission" string="Quá hạn nộp" domain="[('date_end', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'in', ('open', 'sent'))]"/>
                <group expand="0" string="Gom nhóm">
                    <filter name="group_collaborator" string="Cộng tác viên" context="{'group_by': 'th_collaborator_id'}"/>
                    <filter name="group_user" string="Người phụ trách" context="{'group_by': 'user_id'}"/>
                    <filter name="group_batch_date" string="Ngày đẩy hợp đồng" context="{'group_by': 'th_batch_date'}"/>
                    <filter name="group_state" string="Trạng thái" context="{'group_by': 'state'}"/>
                </group>
                <searchpanel>
                    <field name="th_expiration_status" string="Thời hạn" icon="fa-clock-o" enable_counters="1" select="multi"/>
                    <field name="state" string="Trạng thái" icon="fa-tasks" enable_counters="1" select="multi"/>
                </searchpanel>
            </search></field>
    </record>
    <!-- Action Hợp đồng CTV -->
    <record id="th_collaborator_contract_action" model="ir.actions.act_window">
        <field name="name">Hợp đồng CTV</field>
        <field name="res_model">th.collaborator.contract</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="th_collaborator_contract_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo hợp đồng cộng tác viên mới
            </p>
            <p>
                Quản lý vòng đời hợp đồng, gửi email mời CTV ký và tiếp nhận file hợp đồng trực tuyến.
            </p></field>
    </record>
    <!-- Server Action: Hủy hợp đồng -->
    <record id="th_collaborator_contract_action_cancel_server" model="ir.actions.server">
        <field name="name">Hủy hợp đồng</field>
        <field name="model_id" ref="model_th_collaborator_contract"/>
        <field name="binding_model_id" ref="model_th_collaborator_contract"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
records.action_set_cancel()
        </field>
    </record>
</odoo>
