<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Giao diện Thiết lập cấu hình module Cộng tác viên -->
    <record id="res_config_settings_view_form_inherit_collaborator" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.collaborator</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="80"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Cộng tác viên" string="Cộng tác viên" data-key="th_collaborator">
                    <h2>Cấu hình Email Hợp đồng Cộng tác viên</h2>
                    <div class="row mt16 o_settings_container" name="collaborator_mail_settings">
                        <!-- Mẫu email mời ký hợp đồng -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Mẫu email mời ký hợp đồng</span>
                                <div class="text-muted">
                                    Mẫu email phát hành gửi cho CTV kèm liên kết tải lên hợp đồng trực tuyến.
                                </div>
                                <div class="content-group mt8">
                                    <field name="th_contract_mail_template_id" class="w-100" options="{'no_create': True}"/>
                                    <div class="mt4">
                                        <button name="action_open_contract_mail_template" type="object"
                                                string="Chỉnh sửa nội dung mẫu email này" icon="fa-arrow-right" class="btn-link p-0"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Mẫu email nhắc nhở nộp hợp đồng -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Mẫu email nhắc nhở nộp hợp đồng</span>
                                <div class="text-muted">
                                    Mẫu email tự động gửi khi hợp đồng đang thực hiện gần đến hạn hoặc quá hạn nộp.
                                </div>
                                <div class="content-group mt8">
                                    <field name="th_contract_reminder_mail_template_id" class="w-100" options="{'no_create': True}"/>
                                    <div class="mt4">
                                        <button name="action_open_contract_reminder_mail_template" type="object"
                                                string="Chỉnh sửa nội dung mẫu email này" icon="fa-arrow-right" class="btn-link p-0"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quản lý danh sách mẫu email -->
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Danh sách tất cả mẫu email</span>
                                <div class="text-muted">
                                    Xem và tùy biến toàn bộ các mẫu email áp dụng cho Hợp đồng CTV.
                                </div>
                                <div class="mt8">
                                    <button name="action_open_all_collaborator_mail_templates" type="object"
                                            string="Quản lý danh sách mẫu email" icon="fa-list" class="btn-secondary"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Action mở màn hình Thiết lập phân hệ Cộng tác viên -->
    <record id="th_collaborator_config_settings_action" model="ir.actions.act_window">
        <field name="name">Thiết lập Cộng tác viên</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'th_collaborator', 'bin_size': False}</field>
    </record>

    <!-- Action danh sách Mẫu email Hợp đồng CTV -->
    <record id="th_collaborator_mail_template_action" model="ir.actions.act_window">
        <field name="name">Mẫu email hợp đồng</field>
        <field name="res_model">mail.template</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('model_id.model', '=', 'th.collaborator.contract')]</field>
        <field name="context">{'default_model': 'th.collaborator.contract'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo mẫu email hợp đồng mới
            </p>
            <p>
                Quản lý và chỉnh sửa nội dung mẫu email gửi và nhắc nhở hợp đồng CTV.
            </p>
        </field>
    </record>
</odoo>

