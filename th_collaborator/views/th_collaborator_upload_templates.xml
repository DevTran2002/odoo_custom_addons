<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="th_collaborator_upload_page_template" name="Tải hợp đồng CTV">
        <t t-call="web.frontend_layout">
            <t t-set="title">Cổng tải lên hợp đồng cộng tác viên</t>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="container py-5" style="max-width: 720px;">
                <div class="text-center mb-4">
                    <h2 class="fw-bold">Cổng tải lên hợp đồng cộng tác viên</h2>
                    <p class="text-muted">
                        Xin chào <span class="fw-semibold text-primary" t-out="profile.name"/>, vui lòng kiểm tra thông tin hợp đồng và tải lên file đã ký hoàn tất.
                    </p>
                </div>

                <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <div t-if="success" class="alert alert-success" role="alert" t-out="success"/>

                <form t-if="not success" t-attf-action="/th_collaborator/upload/#{token}/submit"
                      method="post" enctype="multipart/form-data" class="card shadow-sm p-4">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- Thông tin chi tiết hợp đồng mục tiêu -->
                    <div class="mb-4 p-3 bg-light rounded border">
                        <h5 class="fw-bold text-dark mb-3">Thông tin hợp đồng</h5>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <span class="text-muted">Mã hợp đồng:</span>
                                <span class="fw-bold ms-1" t-out="contract.th_code"/>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Tên hợp đồng:</span>
                                <span class="fw-bold ms-1" t-out="contract.name"/>
                            </div>
                            <div class="col-sm-6" t-if="contract.th_contract_type_ids">
                                <span class="text-muted">Loại hợp đồng:</span>
                                <span class="ms-1" t-out="', '.join(contract.th_contract_type_ids.mapped('name'))"/>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Trạng thái:</span>
                                <span t-if="contract.state == 'open'" class="badge bg-info text-dark ms-1">Đang thực hiện</span>
                                <span t-elif="contract.state == 'sent'" class="badge bg-primary ms-1">Gửi mail</span>
                                <span t-elif="contract.state == 'submitted'" class="badge bg-warning text-dark ms-1">Đã nộp</span>
                                <span t-elif="contract.state == 'valid'" class="badge bg-info ms-1">Đã duyệt hợp lệ</span>
                                <span t-elif="contract.state == 'close'" class="badge bg-success ms-1">Hoàn tất</span>
                                <span t-else="" class="badge bg-secondary ms-1">Dự thảo / Chờ ký</span>
                            </div>
                        </div>

                        <!-- Tệp mẫu do công ty cung cấp nếu có -->
                        <t t-set="company_doc" t-value="contract.th_document_ids.filtered(lambda d: d.th_document_type in ('company_raw', 'company_signed'))[:1]"/>
                        <t t-set="company_att" t-value="company_doc.th_attachment_id if company_doc else (contract.th_company_attachment_ids and contract.th_company_attachment_ids[0])"/>
                        <div t-if="company_att" class="mt-3 pt-2 border-top">
                            <span class="text-muted me-2">File mẫu từ công ty:</span>
                            <a t-attf-href="/web/content/#{company_att.id}?download=true"
                               class="btn btn-sm btn-outline-primary" target="_blank">
                                Tải file mẫu (<t t-out="company_att.name"/>)
                            </a>
                        </div>
                    </div>

                    <!-- Chọn file hợp đồng đã ký -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold" for="th_contract_files">File hợp đồng đã ký <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="th_contract_files" name="th_contract_files"
                               multiple="multiple" required="required" t-att-accept="th_accept"/>
                        <div class="form-text">
                            Chấp nhận định dạng: <t t-out="th_accept"/>. Tối đa <t t-out="th_max_files"/> file, mỗi file không quá <t t-out="th_max_file_size_mb"/>MB.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100">Gửi hợp đồng</button>
                </form>
            </div>
        </t>
    </template>
</odoo>
