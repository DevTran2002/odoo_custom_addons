<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job định kỳ hằng ngày quét hạn nộp và gửi email nhắc nhở CTV -->
        <record id="th_collaborator_contract_reminder_cron" model="ir.cron">
            <field name="name">CTV: Quét hạn nộp và gửi email nhắc nhở hợp đồng</field>
            <field name="model_id" ref="model_th_collaborator_contract"/>
            <field name="state">code</field>
            <field name="code">model.th_cron_send_contract_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

